<view class="chat-page">
  <scroll-view scroll-y class="msgs" scroll-into-view="{{'msg-' + (messages.length ? messages[messages.length-1].id : '')}}" scroll-with-animation>
    <view class="pad">
      <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="msg-row {{item.sender_openid === myOpenid ? 'me' : ''}}">
        <view wx:if="{{item.sender_openid !== myOpenid}}" class="avatar small">{{item.sender_nickname[0]}}</view>
        <view class="bubble">{{item.content}}</view>
        <view wx:if="{{item.sender_openid === myOpenid}}" class="avatar small me-av">Me</view>
      </view>
      <view wx:if="{{!messages.length}}" class="empty">Start the conversation</view>
    </view>
  </scroll-view>

  <view class="input-bar">
    <input class="input" placeholder="Type a message..." value="{{input}}" bindinput="onInput" confirm-type="send" bindconfirm="onSend"/>
    <view class="send-btn" bindtap="onSend">Send</view>
  </view>

  <view class="report-link muted" bindtap="goReport">Report this user</view>
</view>
