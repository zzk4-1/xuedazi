.tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #5b6572;
  border-radius: 10rpx;
}
.tab.on {
  background: #1f5c4d;
  color: #fff;
  font-weight: 600;
}
