.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.avatar.big {
  width: 110rpx;
  height: 110rpx;
  font-size: 44rpx;
}
.edit {
  font-size: 22rpx;
  margin-left: 16rpx;
}
.nick-input {
  border: 1rpx solid #e3e7ec;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  font-size: 26rpx;
  flex: 1;
}
.menu {
  padding: 0 28rpx;
}
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #e3e7ec;
  font-size: 28rpx;
}
.menu-item:last-child {
  border-bottom: none;
}
