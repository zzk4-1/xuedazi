/* 学搭子全局样式 —— 绿色主题 #1f5c4d */
page {
  --accent: #1f5c4d;
  --accent-soft: #e8f2ef;
  --ink: #1c2430;
  --sub: #5b6572;
  --line: #e3e7ec;
  --warn: #8a5a00;
  --bad: #9c2f2f;
  background: #f2f6f4;
  color: #1c2430;
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.container {
  padding: 24rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(28, 36, 48, 0.04);
}
.card .t {
  font-weight: 600;
  font-size: 30rpx;
}
.card .row2 {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
  color: #5b6572;
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* 标签 */
.pill {
  display: inline-block;
  font-size: 20rpx;
  padding: 2rpx 16rpx;
  border-radius: 18rpx;
  background: #eef1f5;
  color: #5b6572;
  margin-right: 10rpx;
}
.pill.goal {
  background: #e8f2ef;
  color: #1f5c4d;
}

/* 按钮 */
.btn {
  background: #1f5c4d;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
  padding: 18rpx 0;
}
.btn.ghost {
  background: #fff;
  color: #1f5c4d;
  border: 1rpx solid #1f5c4d;
}
.btn.small {
  display: inline-block;
  padding: 8rpx 28rpx;
  font-size: 24rpx;
}
.btn[disabled] {
  background: #c3cdc9;
  color: #fff;
}

/* 筛选 chips */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip {
  border: 1rpx solid #e3e7ec;
  background: #fff;
  border-radius: 32rpx;
  padding: 8rpx 28rpx;
  font-size: 24rpx;
  color: #1c2430;
}
.chip.on {
  background: #1f5c4d;
  border-color: #1f5c4d;
  color: #fff;
}

/* 表单 */
.field {
  margin-bottom: 28rpx;
}
.field .label {
  font-size: 26rpx;
  color: #5b6572;
  margin-bottom: 10rpx;
}
.field .input, .field .textarea, .field .picker {
  background: #fff;
  border: 1rpx solid #e3e7ec;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}
.field .textarea {
  min-height: 140rpx;
}

/* 头像 */
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e8f2ef;
  color: #1f5c4d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 30rpx;
  flex: none;
  overflow: hidden;
}
.avatar image {
  width: 100%;
  height: 100%;
}

/* 空状态 */
.empty {
  text-align: center;
  color: #5b6572;
  padding: 80rpx 20rpx;
  font-size: 26rpx;
}

/* 列表行 */
.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.muted {
  color: #5b6572;
  font-size: 24rpx;
}
.accent {
  color: #1f5c4d;
}
.divider {
  height: 1rpx;
  background: #e3e7ec;
  margin: 20rpx 0;
}
